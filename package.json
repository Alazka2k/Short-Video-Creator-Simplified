    "start:llm": "node backend/services/llm-service/index.js",
    "start:image": "node backend/services/image-service/index.js",
    "start:voice": "node backend/services/voice-service/index.js",
    "start:animation": "node backend/services/animation-service/index.js",
    "start:video": "node backend/services/video-service/index.js",
    "start:music": "node backend/services/music-service/index.js",
    "start:assembly": "node backend/services/assembly-service/index.js",
    "start:job": "node backend/services/job-service/index.js",
    "start:auth": "node backend/services/auth-service/auth-service.js",
    "start:subscription": "node backend/services/subscription-service/index.js",
    "start:batch": "node backend/batches/server.js",
