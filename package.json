{
  "name": "short-video-creator-simplified",
  "version": "0.0.2",
  "description": "A tool for creating short video content using AI services",
  "main": "src/index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development concurrently \"npm run dev:frontend\" \"npm run dev:docs\" \"npm run dev:all-services\"",
    "staging": "cross-env NODE_ENV=staging concurrently \"npm run staging:frontend\" \"npm run staging:docs\" \"npm run staging:all-services\"",
    "prod": "cross-env NODE_ENV=production concurrently \"npm run prod:frontend\" \"npm run prod:docs\" \"npm run prod:all-services\"",
    "dev:frontend": "cd frontend && cross-env NODE_ENV=development npm run dev",
    "staging:frontend": "cd frontend && cross-env NODE_ENV=staging npm run dev",
    "prod:frontend": "cd frontend && cross-env NODE_ENV=production npm run start",
    "dev:docs": "cd docs-site && cross-env NODE_ENV=development npm start",
    "staging:docs": "cd docs-site && cross-env NODE_ENV=staging npm start",
    "prod:docs": "cd docs-site && cross-env NODE_ENV=production npm start",
    "dev:all-services": "cross-env NODE_ENV=development concurrently \"npm run dev:gateway\" \"npm run dev:auth\" \"npm run dev:llm\" \"npm run dev:image\" \"npm run dev:voice\" \"npm run dev:animation\" \"npm run dev:video\" \"npm run dev:music\" \"npm run dev:assembly\" \"npm run dev:job\" \"npm run dev:subscription\" \"npm run dev:batch\"",
