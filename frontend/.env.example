# Single Page Application Credentials   
NEXT_PUBLIC_APP_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_AUTH0_DOMAIN=your-dev-domain.auth0.com
NEXT_PUBLIC_AUTH0_AUDIENCE=your-dev-audience

# SPA Application Credentials
NEXT_PUBLIC_AUTH0_SPA_CLIENT_ID=your-dev-spa-client-id

# M2M Application Credentials
NEXT_PUBLIC_AUTH0_M2M_CLIENT_ID=your-dev-m2m-client-id
NEXT_PUBLIC_AUTH0_M2M_CLIENT_SECRET=your-dev-m2m-client-secret

# S3 Bucket Credentials
NEXT_PUBLIC_S3_BUCKET_NAME=your-dev-s3-bucket-name

# EmailJS Credentials
NEXT_PUBLIC_SMTP_HOST=your-dev-smtp-host
NEXT_PUBLIC_SMTP_PORT=your-dev-smtp-port
NEXT_PUBLIC_SMTP_SECURE=your-dev-smtp-secure
NEXT_PUBLIC_SMTP_USER=your-dev-smtp-user
NEXT_PUBLIC_SMTP_PASSWORD=your-dev-smtp-password
NEXT_PUBLIC_CONTACT_FROM_EMAIL=your-dev-contact-from-email
NEXT_PUBLIC_CONTACT_TO_EMAIL=your-dev-contact-to-email

# Encryption Key for encrypting api calls from the frontend to the backend (e.g. user data)
# Command to generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXT_PUBLIC_ENCRYPTION_KEY=your-secure-encryption-key-change-in-production

# Beehiiv Newsletter Integration
# Note: You don't need to add these to .env files - they'll be embedded directly in the page
# These are for documentation purposes only
# BEEHIIV_PUBLICATION_ID=your-publication-id
# BEEHIIV_FORM_ID=your-form-id
