PRODUCTION_JWT_SECRET=prod-jwt-secret
## Database
PRODUCTION_DB_HOST=production_db_host
PRODUCTION_DB_USER=production_user
PRODUCTION_DB_PASSWORD=production_password
PRODUCTION_DB_NAME=production_db
PRODUCTION_DB_PORT=5432
## AWS
PRODUCTION_AWS_ACCESS_KEY_ID=your_prod_access_key
PRODUCTION_AWS_SECRET_ACCESS_KEY=your_prod_secret_key
