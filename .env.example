PRODUCTION_AUTH0_M2M_DOMAIN=prod-domain.auth0.com
PRODUCTION_AUTH0_M2M_CLIENT_ID=prod-client-id
PRODUCTION_AUTH0_M2M_AUDIENCE=https://api.prod-domain.com
