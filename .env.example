# .env

# Ports
API_GATEWAY_PORT=3000
LLM_SERVICE_PORT=3001
IMAGE_SERVICE_PORT=3002
VOICE_SERVICE_PORT=3003
ANIMATION_SERVICE_PORT=3004
VIDEO_SERVICE_PORT=3005
MUSIC_SERVICE_PORT=3006
ASSEMBLY_SERVICE_PORT=3007
JOB_SERVICE_PORT=3008
AUTH_SERVICE_PORT=3009
BILLING_SERVICE_PORT=3010
FRONTEND_PORT=4000
DOCS_SERVICE_PORT=4001

# URLs
GATEWAY_SERVICE_URL=http://localhost:3000
LLM_SERVICE_URL=http://localhost:3001
IMAGE_SERVICE_URL=http://localhost:3002
VOICE_SERVICE_URL=http://localhost:3003
ANIMATION_SERVICE_URL=http://localhost:3004
VIDEO_SERVICE_URL=http://localhost:3005
MUSIC_SERVICE_URL=http://localhost:3006
ASSEMBLY_SERVICE_URL=http://localhost:3007
JOB_SERVICE_URL=http://localhost:3008
AUTH_SERVICE_URL=http://localhost:3009
BILLING_SERVICE_URL=http://localhost:3010
FRONTEND_URL=http://localhost:4000
DOCS_SERVICE_URL=http://localhost:4001

# LLM Configuration
LLM_PROVIDER=openai
LLM_MODEL=your-model-name
LLM_API_KEY=your-api-key

# Voice Generation
VOICE_PROVIDER=elevenlabs
VOICE_API_KEY=your-api-key
VOICE_MODEL_ID=your-model-id
VOICE_ID=your-voice-id

# Image Generation
IMAGE_PROVIDER=midjourney
IMAGE_SERVER_ID=your-server-id
IMAGE_CHANNEL_ID=your-channel-id
IMAGE_SALAI_TOKEN=your-salai-token
IMAGE_DEBUG=false
IMAGE_WS=true

# Music Generation
MUSIC_PROVIDER=acedata
MUSIC_MODEL_ID=your-model-id
MUSIC_API_KEY=your-api-key

# Animation Generation
ANIMATION_PROVIDER=immersityAI
ANIMATION_CLIENT_ID=your-client-id
ANIMATION_CLIENT_SECRET=your-client-secret

# Video Generation
VIDEO_PROVIDER=lumalabsAI
VIDEO_MODEL=your-model
VIDEO_RESOLUTION=720p
VIDEO_API_KEY=your-api-key

# Assembly
ASSEMBLY_PROVIDER=creatomate
ASSEMBLY_API_KEY=your-api-key
ASSEMBLY_WEBHOOK_BASE_URL=your-webhook-url

# Subscription / Payment Provider: Stripe
STRIPE_API_KEY=your-api-key
STRIPE_WEBHOOK_BASE_URL=your-webhook-url

# Auth0 Configuration
AUTH0_DOMAIN=your-domain.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
AUTH0_AUDIENCE=https://api.your-domain.com

# JWT Configuration (locally created commmand 'node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"')
JWT_SECRET=your-jwt-secret

# Database Configuration
DB_HOST=localhost
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=your-db-name
DB_PORT=5432

# AWS Configuration
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=your-region
AWS_BUCKET=your-bucket-name
CDN_URL=https://your-cdn-url.com

# File Paths
INPUT_CSV_PATH=./data/input/input.csv
PARAMETERS_JSON_PATH=./data/input/parameters.json
INITIAL_PROMPT_PATH=./data/input/initial_prompt.txt
OUTPUT_DIRECTORY=./data/output
