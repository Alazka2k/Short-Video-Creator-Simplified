# .env

# Set the current environment
NODE_ENV=development

# Development Environment Variables
## Service URLs and Ports
DEVELOPMENT_API_GATEWAY_PORT=3000
DEVELOPMENT_FRONTEND_PORT=4000
DEVELOPMENT_DOCS_SERVICE_PORT=4001
DEVELOPMENT_LLM_SERVICE_URL=http://localhost:3001
DEVELOPMENT_IMAGE_SERVICE_URL=http://localhost:3002
DEVELOPMENT_VOICE_SERVICE_URL=http://localhost:3003
DEVELOPMENT_ANIMATION_SERVICE_URL=http://localhost:3004
DEVELOPMENT_VIDEO_SERVICE_URL=http://localhost:3005
DEVELOPMENT_MUSIC_SERVICE_URL=http://localhost:3006
DEVELOPMENT_ASSEMBLY_SERVICE_URL=http://localhost:3007
DEVELOPMENT_JOB_SERVICE_URL=http://localhost:3008
DEVELOPMENT_AUTH_SERVICE_URL=http://localhost:3009
DEVELOPMENT_BILLING_SERVICE_URL=http://localhost:3010
DEVELOPMENT_DOCS_SERVICE_URL=http://localhost:4001
## Auth0 (machine to machine application)
DEVELOPMENT_DB_HOST=dev_db_host
DEVELOPMENT_AUTH0_DOMAIN=dev-domain.auth0.com
DEVELOPMENT_AUTH0_CLIENT_ID=dev-client-id
DEVELOPMENT_AUTH0_AUDIENCE=https://api.dev-domain.com
DEVELOPMENT_AUTH0_CLIENT_SECRET=development-secret
## JWT (locally created commmand 'node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"')
DEVELOPMENT_JWT_SECRET=development-jwt-secret
## Database
DEVELOPMENT_DB_USER=development_user
DEVELOPMENT_DB_PASSWORD=development_password
DEVELOPMENT_DB_NAME=development_db
DEVELOPMENT_DB_PORT=5432
## AWS
DEVELOPMENT_AWS_ACCESS_KEY_ID=development_access_key
DEVELOPMENT_AWS_SECRET_ACCESS_KEY=development_secret_key
DEVELOPMENT_AWS_REGION=eu-central-1
DEVELOPMENT_AWS_BUCKET=short-video-creator-dev
DEVELOPMENT_CDN_URL=https://dev-cdn.your-domain.com

# Staging Environment Variables
## Service URLs
STAGING_LLM_SERVICE_URL= staging-llm-service-url   
STAGING_IMAGE_SERVICE_URL= staging-image-service-url    
STAGING_VOICE_SERVICE_URL= staging-voice-service-url    
STAGING_ANIMATION_SERVICE_URL= staging-animation-service-url    
STAGING_VIDEO_SERVICE_URL= staging-video-service-url    
STAGING_MUSIC_SERVICE_URL= staging-music-service-url    
STAGING_ASSEMBLY_SERVICE_URL= staging-assembly-service-url    
STAGING_JOB_SERVICE_URL= staging-job-service-url    
STAGING_AUTH_SERVICE_URL= staging-auth-service-url    
STAGING_BILLING_SERVICE_URL= staging-billing-service-url    
STAGING_DOCS_SERVICE_URL= staging-docs-service-url    
## Auth0 (machine to machine application)
STAGING_DB_HOST=staging_db_host
STAGING_AUTH0_DOMAIN=staging-domain.auth0.com
STAGING_AUTH0_CLIENT_ID=staging-client-id
STAGING_AUTH0_AUDIENCE=https://api.staging-domain.com
STAGING_AUTH0_CLIENT_SECRET=staging-secret 
## JWT (locally created commmand 'node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"')
STAGING_JWT_SECRET=staging-jwt-secret
## Database
STAGING_DB_USER=staging_user
STAGING_DB_PASSWORD=staging_password
STAGING_DB_NAME=staging_db
STAGING_DB_PORT=5432
## AWS
STAGING_AWS_ACCESS_KEY_ID=your_staging_access_key
STAGING_AWS_SECRET_ACCESS_KEY=your_staging_secret_key
STAGING_AWS_REGION=eu-central-1
STAGING_AWS_BUCKET=short-video-creator-staging
STAGING_CDN_URL=https://staging-cdn.your-domain.com

# Production Environment Variables
## Service URLs
PRODUCTION_LLM_SERVICE_URL=production-llm-service-url
PRODUCTION_IMAGE_SERVICE_URL=production-image-service-url
PRODUCTION_VOICE_SERVICE_URL=production-voice-service-url
PRODUCTION_ANIMATION_SERVICE_URL=production-animation-service-url
