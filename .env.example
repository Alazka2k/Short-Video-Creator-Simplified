PRODUCTION_ASSEMBLY_SERVICE_URL=production-assembly-service-url
PRODUCTION_JOB_SERVICE_URL=production-job-service-url
PRODUCTION_AUTH_SERVICE_URL=production-auth-service-url
PRODUCTION_BILLING_SERVICE_URL=production-billing-service-url
