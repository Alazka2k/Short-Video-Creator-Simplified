{
  "info": {
    "name": "Batch Jobs API",
    "description": "Collection for testing batch job endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "General Batch Endpoints",
      "item": [
        {
          "name": "Get All Available Batches",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/batch/batches",
              "host": ["{{base_url}}"],
              "path": ["api", "batch", "batches"]
            }
          }
        },
        {
          "name": "Run a Specific Batch",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"force\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/batch/batches/{{batch_id}}/run",
              "host": ["{{base_url}}"],
              "path": ["api", "batch", "batches", "{{batch_id}}", "run"],
              "variable": [
                {
                  "key": "batch_id",
                  "value": "create-payments"
                }
              ]
            }
          }
        },
        {
          "name": "Get Batch Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/batch/batches/{{batch_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["api", "batch", "batches", "{{batch_id}}", "status"],
              "variable": [
                {
                  "key": "batch_id",
                  "value": "create-payments"
                }
              ]
            }
          }
        },
        {
          "name": "Get Batch History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/batch/batches/{{batch_id}}/history",
              "host": ["{{base_url}}"],
              "path": ["api", "batch", "batches", "{{batch_id}}", "history"],
              "variable": [
                {
                  "key": "batch_id",
                  "value": "create-payments"
                }
              ]
            }
          }
        },
        {
          "name": "Get Batch Logs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/batch/batches/{{batch_id}}/logs",
              "host": ["{{base_url}}"],
              "path": ["api", "batch", "batches", "{{batch_id}}", "logs"],
              "variable": [
                {
                  "key": "batch_id",
                  "value": "create-payments"
                }
              ]
            }
          }
        }
      ]
    },
